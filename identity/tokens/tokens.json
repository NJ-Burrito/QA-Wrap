{
  "meta": {
    "name": "QA Wrap",
    "owner": "Nader Alzghoul",
    "byline": "by Nader Alzghoul",
    "publisher": "Nader Alzghoul",
    "version": "3.1.0"
  },
  "brand": {
    "petra": {
      "light": "#B5432B",
      "dark": "#FF8A6E",
      "use": "Rose-red sandstone. FAIL. Never decoration. (Was also the one action colour; accent moved to ochre, decision 118.)"
    },
    "guac": {
      "light": "#2A7A3B",
      "dark": "#7ED08A",
      "use": "A pass. Saved, complete, verified."
    },
    "corn": {
      "light": "#E2AE38",
      "dark": "#FFD166",
      "use": "The small warm highlight — foil catching light. Never carries small text."
    },
    "tortilla": {
      "light": "#D8C6A4",
      "dark": "#6F5C40",
      "use": "Borders, the foil, the burrito."
    },
    "limestone": {
      "light": "#F1EFE9",
      "dark": "#ECEAE3",
      "use": "Amman by day: the ground in light, the ink at night."
    },
    "basalt": {
      "light": "#1D2024",
      "dark": "#15181B",
      "use": "The northern basalt: the ink by day, the ground at night."
    },
    "wadirum": {
      "light": "#8E5A10",
      "dark": "#F1BE5C",
      "use": "Ochre. BLOCKED, and nothing else."
    }
  },
  "neutral": {
    "0": {
      "light": "#FAF8F4",
      "dark": "#262B30"
    },
    "25": {
      "light": "#F6F4EF",
      "dark": "#20252A"
    },
    "50": {
      "light": "#F1EFE9",
      "dark": "#15181B"
    },
    "100": {
      "light": "#E8E5DE",
      "dark": "#2C3238"
    },
    "200": {
      "light": "#DAD6CD",
      "dark": "#323940"
    },
    "300": {
      "light": "#B4B0A6",
      "dark": "#454C53"
    },
    "500": {
      "light": "#5D646B",
      "dark": "#A3A9AF"
    },
    "600": {
      "light": "#4C535A",
      "dark": "#B9BFC4"
    },
    "700": {
      "light": "#353B41",
      "dark": "#CDD2D6"
    },
    "900": {
      "light": "#262B30",
      "dark": "#ECEAE3"
    }
  },
  "surface": {
    "surface": {
      "light": "var(--n-0)",
      "dark": "#1D2125"
    },
    "surface-sunken": {
      "light": "var(--n-50)",
      "dark": "#15181B"
    },
    "surface-raised": {
      "light": "#F7F5F1",
      "dark": "#272A2F"
    },
    "border": {
      "light": "rgba(29, 32, 36, 0.12)",
      "dark": "rgba(239, 237, 232, 0.12)"
    },
    "border-strong": {
      "light": "#82868D",
      "dark": "#7A7F86"
    },
    "text": {
      "light": "var(--n-900)",
      "dark": "var(--n-900)"
    },
    "text-muted": {
      "light": "var(--n-500)",
      "dark": "var(--n-500)"
    }
  },
  "semantic": {
    "accent": {
      "light": "#8E5A10",
      "dark": "#F1BE5C",
      "use": "Ochre, as the interactive fill (decision 118). Was Petra."
    },
    "accent-hover": {
      "light": "#794D0E",
      "dark": "#F3C670"
    },
    "accent-soft": {
      "light": "#F8EBD8",
      "dark": "#3B2E15"
    },
    "accent-text": {
      "light": "#FFFFFF",
      "dark": "#1D1405",
      "use": "Text ON an accent fill."
    },
    "accent-ink": {
      "light": "#633F0B",
      "dark": "#F5D08A",
      "use": "Accent-coloured TEXT on a pale ground or on its tint. AA at 14px."
    },
    "pass": {
      "light": "#2A7A3B",
      "dark": "#7ED08A",
      "use": "PASS. Guac."
    },
    "pass-soft": {
      "light": "#E1F0E3",
      "dark": "#1B3321"
    },
    "pass-ink": {
      "light": "#1E6630",
      "dark": "#8FDB9A",
      "use": "PASS text on its own tint or on a pale ground."
    },
    "fail": {
      "light": "#B5432B",
      "dark": "#FF9270",
      "use": "FAIL. Petra."
    },
    "fail-soft": {
      "light": "#FAE5E0",
      "dark": "#3D2019"
    },
    "fail-ink": {
      "light": "#9C3520",
      "dark": "#FFA487",
      "use": "FAIL text on its own tint or on a pale ground."
    },
    "blocked": {
      "light": "#6E5B14",
      "dark": "#D4C274",
      "use": "BLOCKED / restricted / worker errors. Olive-mustard — re-pitched off ochre (decision 118) so it cannot collide with the accent, and off Petra so red stays FAIL-only."
    },
    "blocked-soft": {
      "light": "#F3EBCF",
      "dark": "#352D13"
    },
    "blocked-ink": {
      "light": "#5C4C10",
      "dark": "#DDCD85",
      "use": "BLOCKED/warn text on its own tint or on a pale ground."
    },
    "skipped": {
      "light": "#5D646B",
      "dark": "#B3B8BE",
      "use": "SKIPPED. Slate."
    },
    "skipped-soft": {
      "light": "#ECECEA",
      "dark": "#2A2D31"
    },
    "skipped-ink": {
      "light": "#4D535A",
      "dark": "#BFC4C9",
      "use": "SKIPPED text on its own tint or on a pale ground."
    },
    "ok": {
      "light": "var(--pass)",
      "dark": "var(--pass)"
    },
    "ok-soft": {
      "light": "var(--pass-soft)",
      "dark": "var(--pass-soft)"
    },
    "danger": {
      "light": "var(--fail)",
      "dark": "var(--fail)"
    },
    "danger-soft": {
      "light": "var(--fail-soft)",
      "dark": "var(--fail-soft)"
    },
    "warn": {
      "light": "var(--blocked)",
      "dark": "var(--blocked)"
    },
    "warn-soft": {
      "light": "var(--blocked-soft)",
      "dark": "var(--blocked-soft)"
    },
    "warn-ink": {
      "light": "var(--blocked-ink)",
      "dark": "var(--blocked-ink)"
    },
    "info": {
      "light": "var(--skipped)",
      "dark": "var(--skipped)"
    },
    "info-soft": {
      "light": "var(--skipped-soft)",
      "dark": "var(--skipped-soft)"
    }
  },
  "type": {
    "display": "\"Thmanyah Serif Display\", \"Thmanyah Sans\", system-ui, \"Segoe UI\", Tahoma, sans-serif",
    "font": "\"Thmanyah Sans\", system-ui, \"Segoe UI\", Tahoma, sans-serif",
    "mono": "\"Thmanyah Sans\", system-ui, sans-serif"
  },
  "webfont": null,
  "radius": {
    "sm": "4px",
    "md": "8px",
    "lg": "12px",
    "xl": "16px",
    "pill": "999px"
  },
  "shadow": {
    "1": {
      "light": "0 1px 1px rgba(29, 32, 36, 0.05)",
      "dark": "0 1px 1px rgba(0, 0, 0, 0.35)"
    },
    "2": {
      "light": "0 8px 24px rgba(29, 32, 36, 0.12), 0 1px 2px rgba(29, 32, 36, 0.06)",
      "dark": "0 8px 24px rgba(0, 0, 0, 0.45), 0 1px 2px rgba(0, 0, 0, 0.30)"
    }
  },
  "motion": {
    "ease": "cubic-bezier(.22, .9, .28, 1)",
    "ease-pop": "cubic-bezier(.34, 1.56, .64, 1)",
    "dur-tap": "120ms"
  }
}
