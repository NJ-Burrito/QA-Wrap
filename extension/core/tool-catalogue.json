    },
    {
      "tool": "a11y",
      "group": "check",
      "label": "Check accessibility",
      "send": "UQA_SCAN_A11Y",
      "session": true
    },
    {
      "tool": "perf",
      "group": "check",
      "label": "Check page speed",
      "send": "UQA_SCAN_PERF",
